# Replace these placeholders with your own Azure resource names before deployment.
AZURE_RESOURCE_GROUP=your-resource-group
AKS_NAME=your-aks-cluster
KARS_ACR_NAME=yourkarsregistry
AZURE_LOCATION=

KARS_SANDBOX_NAME=fabrikam-release-pilot
GITHUB_COPILOT_MODEL=gpt-5.6-sol
KARS_RELEASE=v0.1.25
SUPPORT_OWNER=forge-operations
TASK_CONCURRENCY_LIMIT=2
DAILY_TASK_LIMIT=20

# Safe default: validate locally without changing Azure.
DEPLOY_AZURE=false

# Required only by `make rollback`.
ROLLBACK_IMAGE=
